# Path to your compatible .library folder
LIBRARY_PATH=<path to your .library folder>

# Optional Thumbnail Settings
# THUMBNAIL_HEIGHT=400
# THUMBNAIL_QUALITY=80

# Optional: comma-separated hostnames allowed to reach the dev server.
# Unset = any host (convenient for LAN use).
# ALLOWED_HOSTS=

# Optional request protection (defense in depth, not authentication; limits are
# per process and per client address, and every block expires on its own).
# UNLOCK_RATE_LIMIT=10            unlock attempts per client per window
# UNLOCK_RATE_WINDOW_SECONDS=60
# SCAN_RATE_LIMIT=5               scan requests per client per window
# SCAN_RATE_WINDOW_SECONDS=60
# SCAN_COOLDOWN_SECONDS=10        global pause after a scan starts/finishes (0 = off)

# Unlock cookies get the Secure attribute automatically on HTTPS requests.
# Set true behind a TLS-terminating reverse proxy (the app only sees HTTP there);
# set false to never add it. Leave unset for plain-HTTP LAN use.
# COOKIE_SECURE=
