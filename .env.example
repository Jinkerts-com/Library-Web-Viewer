# Path to your compatible .library folder
LIBRARY_PATH=<path to your .library folder>

# Optional Thumbnail Settings
# THUMBNAIL_HEIGHT=400
# THUMBNAIL_QUALITY=80

# Optional: address and port `bun run start` listens on (--host/--port flags override).
# HOST=0.0.0.0
# PORT=4321

# Optional: set to true for verbose server/CLI logging.
# VERBOSE=false

# DEV SERVER ONLY (bun run dev): comma-separated hostnames the Vite dev server accepts.
# Unset = any host. The production server (bun run start) ignores this and does NOT
# enforce a hostname allowlist; restrict access with --host, a firewall/VPN or a reverse proxy.
# ALLOWED_HOSTS=

# Optional request protection (defense in depth, not authentication; limits are
# per process and per client address, and every block expires on its own).
# UNLOCK_RATE_LIMIT=10            unlock attempts per client per window
# UNLOCK_RATE_WINDOW_SECONDS=60
# SCAN_RATE_LIMIT=5               scan requests per client per window
# SCAN_RATE_WINDOW_SECONDS=60
# SCAN_COOLDOWN_SECONDS=10        global pause after a scan starts/finishes (0 = off)

# Optional tuning (see README "Performance and capacity"). Both are per process.
# WATCH_POLL_INTERVAL_MS=2000     library watcher polling interval, 500-60000 (higher = less CPU/IO on a NAS, slower change detection)
# SSE_MAX_LISTENERS=100           open scan-status streams before Node's leak warning fires, 10-1000 (not a connection limit)

# Unlock cookies get the Secure attribute automatically on HTTPS requests.
# Set true behind a TLS-terminating reverse proxy (the app only sees HTTP there);
# set false to never add it. Leave unset for plain-HTTP LAN use.
# COOKIE_SECURE=
